{
  "name": "mdg-utils-spec",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "validate": "node tools/validate/index.ts",
    "stale-data": "node tools/stale-data/index.ts",
    "new-module": "node tools/new-module/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check . && pnpm typecheck && knip",
    "format": "prettier --write .",
    "hooks": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
