{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdgascar/mdg-utils-spec/modules/words/schema.json",
  "title": "Malagasy number words",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zero",
    "units",
    "unitOneInCompound",
    "decimalSeparator",
    "tens",
    "hundreds",
    "scales",
    "traditionalScales",
    "joiners",
    "limits",
    "compoundScale",
    "ordinals"
  ],
  "$defs": {
    "word": {
      "type": "string",
      "pattern": "^[a-zà-ỳ' ]+$"
    },
    "sourced": {
      "$ref": "../../schemas/source.schema.json"
    },
    "entry": {
      "allOf": [
        {
          "$ref": "#/$defs/sourced"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["word"],
      "properties": {
        "word": {
          "$ref": "#/$defs/word"
        },
        "source": true,
        "checked": true
      }
    },
    "valued": {
      "allOf": [
        {
          "$ref": "#/$defs/sourced"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["value", "word"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "word": {
          "$ref": "#/$defs/word"
        },
        "source": true,
        "checked": true
      }
    },
    "nine": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/valued"
      }
    }
  },
  "properties": {
    "zero": {
      "$ref": "#/$defs/entry"
    },
    "units": {
      "$ref": "#/$defs/nine"
    },
    "unitOneInCompound": {
      "$ref": "#/$defs/entry"
    },
    "decimalSeparator": {
      "$ref": "#/$defs/entry"
    },
    "tens": {
      "$ref": "#/$defs/nine"
    },
    "hundreds": {
      "$ref": "#/$defs/nine"
    },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/sourced"
          }
        ],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["value", "word"],
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1000
          },
          "word": {
            "$ref": "#/$defs/word"
          },
          "maxCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "source": true,
          "checked": true
        }
      }
    },
    "traditionalScales": {
      "description": "Rule 12: one name per power of ten from 10³, each taking a single digit 1–9.",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/sourced"
          }
        ],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["value", "word"],
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1000
          },
          "word": {
            "$ref": "#/$defs/word"
          },
          "derived": {
            "const": true,
            "description": "Not attested: built by the source's own naming rule."
          },
          "source": true,
          "checked": true
        }
      }
    },
    "joiners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitsBeforeTen", "belowThousand", "betweenGroups"],
      "properties": {
        "unitsBeforeTen": {
          "$ref": "#/$defs/entry"
        },
        "belowThousand": {
          "$ref": "#/$defs/entry"
        },
        "betweenGroups": {
          "$ref": "#/$defs/entry"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "maxTextLength", "maxWordsLength"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "maxTextLength": {
          "type": "integer",
          "minimum": 1
        },
        "maxWordsLength": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest words text read by parseWords."
        }
      }
    },
    "compoundScale": {
      "description": "Rule 6: the word for 10ⁿ followed by this word is 10ⁿ⁺⁹.",
      "$ref": "#/$defs/entry"
    },
    "ordinals": {
      "description": "Rule 14: ordinal words.",
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "prefix", "prefixBeforeVowel", "vowels"],
      "properties": {
        "first": {
          "$ref": "#/$defs/entry"
        },
        "prefix": {
          "$ref": "#/$defs/entry"
        },
        "prefixBeforeVowel": {
          "$ref": "#/$defs/entry"
        },
        "vowels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]$"
          }
        }
      }
    }
  }
}
