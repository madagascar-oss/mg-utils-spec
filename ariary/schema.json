{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madagascar-oss/mg-utils/spec/ariary/schema.json",
  "title": "Malagasy Ariary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "currency",
    "symbolSeparator",
    "grouping",
    "groupSeparators",
    "readableSeparators",
    "currencyTokens",
    "legacyFranc",
    "limits"
  ],
  "$defs": {
    "sourced": { "$ref": "../_schemas/source.schema.json" },
    "character": { "type": "string", "minLength": 1, "maxLength": 1 }
  },
  "properties": {
    "currency": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["code", "symbol", "name", "word"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "symbol": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "word": { "type": "string", "pattern": "^[a-z]+$" },
        "source": true,
        "checked": true
      }
    },
    "symbolSeparator": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["value"],
      "properties": { "value": { "$ref": "#/$defs/character" }, "source": true, "checked": true }
    },
    "grouping": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["size"],
      "properties": { "size": { "type": "integer", "minimum": 1 }, "source": true, "checked": true }
    },
    "groupSeparators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{ "$ref": "#/$defs/sourced" }],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "value": { "$ref": "#/$defs/character" },
          "source": true,
          "checked": true
        }
      }
    },
    "readableSeparators": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/character", "not": { "const": "," } }
        },
        "source": true,
        "checked": true
      }
    },
    "currencyTokens": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z]+$" }
        },
        "source": true,
        "checked": true
      }
    },
    "legacyFranc": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["code", "symbol", "francsPerAriary", "lastDay"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "symbol": { "type": "string", "minLength": 1 },
        "francsPerAriary": { "type": "integer", "minimum": 1 },
        "lastDay": { "type": "string", "format": "date" },
        "source": true,
        "checked": true
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "maximum": 9007199254740991 }
      }
    }
  }
}
