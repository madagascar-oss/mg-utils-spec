{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madagascar-oss/mg-utils/spec/phone/schema.json",
  "title": "Madagascar mobile numbering",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "operators"],
  "$defs": {
    "digits": { "type": "string", "pattern": "^[0-9]+$" }
  },
  "properties": {
    "plan": {
      "allOf": [{ "$ref": "../_schemas/source.schema.json" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "countryCode",
        "internationalPrefix",
        "trunkPrefix",
        "nationalNumberLength",
        "grouping"
      ],
      "properties": {
        "countryCode": { "$ref": "#/$defs/digits" },
        "internationalPrefix": { "$ref": "#/$defs/digits" },
        "trunkPrefix": { "$ref": "#/$defs/digits" },
        "nationalNumberLength": { "type": "integer", "minimum": 1 },
        "grouping": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "source": true,
        "checked": true
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{ "$ref": "../_schemas/source.schema.json" }],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["id", "name", "prefixes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "prefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^3[0-9]$" }
          },
          "source": true,
          "checked": true
        }
      }
    }
  }
}
