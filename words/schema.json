{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madagascar-oss/mg-utils/spec/words/schema.json",
  "title": "Malagasy number words",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zero",
    "units",
    "unitOneInCompound",
    "tens",
    "hundreds",
    "scales",
    "joiners",
    "limits"
  ],
  "$defs": {
    "word": { "type": "string", "pattern": "^[a-zà-ỳ' ]+$" },
    "sourced": { "$ref": "../_schemas/source.schema.json" },
    "entry": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["word"],
      "properties": { "word": { "$ref": "#/$defs/word" }, "source": true, "checked": true }
    },
    "valued": {
      "allOf": [{ "$ref": "#/$defs/sourced" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["value", "word"],
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "word": { "$ref": "#/$defs/word" },
        "source": true,
        "checked": true
      }
    },
    "nine": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/valued" } }
  },
  "properties": {
    "zero": { "$ref": "#/$defs/entry" },
    "units": { "$ref": "#/$defs/nine" },
    "unitOneInCompound": { "$ref": "#/$defs/entry" },
    "tens": { "$ref": "#/$defs/nine" },
    "hundreds": { "$ref": "#/$defs/nine" },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{ "$ref": "#/$defs/sourced" }],
        "type": "object",
        "unevaluatedProperties": false,
        "required": ["value", "word", "maxCount"],
        "properties": {
          "value": { "type": "integer", "minimum": 1000 },
          "word": { "$ref": "#/$defs/word" },
          "maxCount": { "type": "integer", "minimum": 1, "maximum": 999 },
          "source": true,
          "checked": true
        }
      }
    },
    "joiners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitsBeforeTen", "belowThousand", "betweenGroups"],
      "properties": {
        "unitsBeforeTen": { "$ref": "#/$defs/entry" },
        "belowThousand": { "$ref": "#/$defs/entry" },
        "betweenGroups": { "$ref": "#/$defs/entry" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "maximum": 9007199254740991 }
      }
    }
  }
}
