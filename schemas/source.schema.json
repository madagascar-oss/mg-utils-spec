{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdgascar/mdg-utils-spec/schemas/source.schema.json",
  "title": "Provenance carried by every data entry",
  "type": "object",
  "required": ["source", "checked"],
  "properties": {
    "source": { "type": "string", "format": "uri", "pattern": "^https://" },
    "checked": { "type": "string", "format": "date" }
  }
}
